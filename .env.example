# =============================================================================
# PROVIDER SELECTION
# =============================================================================
# Choose between Azure OpenAI (hosted, parallel execution) or Ollama (local, sequential)
PROVIDER=azure_openai  # or "ollama"

# =============================================================================
# AZURE OPENAI CONFIGURATION (when PROVIDER=azure_openai)
# =============================================================================
# REQUIRED when using Azure OpenAI provider
AZURE_OPENAI_ENDPOINT=https://[your-resource-name].cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=[your-key-from-azure-portal]

# Optional Azure OpenAI settings
AZURE_OPENAI_MODEL=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MAX_TOKENS=128000
AZURE_OPENAI_REASONING_EFFORT=high  # high|medium|low|minimal

# =============================================================================
# OLLAMA CONFIGURATION (when PROVIDER=ollama)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=hf.co/bartowski/Qwen_Qwen3-30B-A3B-Thinking-2507-GGUF:Q5_K_M
OLLAMA_NUM_CTX=36992

# =============================================================================
# CORE TEAM CONFIGURATION
# =============================================================================
# Comma-separated list of specialists who start "in" the room
# Chair is always present (not listed here)
# Other specialists are "available" and can be brought in by Chair when needed
CORE_TEAM=context,research,skeptic,ethicist

# =============================================================================
# SHARED CONFIGURATION (both providers)
# =============================================================================
# Sampling parameters
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# History compression: After Phase 2, hide Phase 1 & 2 individual responses,
# keeping only Chair's Phase 2 synthesis + Phase 3+ messages
COMPRESS_HISTORY_AFTER_PHASE3=true

# Checkpoint system: Save conversation state after each phase
ENABLE_CHECKPOINTS=true
CHECKPOINT_FILE=.axion_checkpoint.json

# Rate-limit-triggered compression (experimental, disabled by default)
RATE_LIMIT_COMPRESSION=false
RATE_LIMIT_COMPRESSION_MIN_MESSAGES=10
RATE_LIMIT_COMPRESSION_MIN_TOKENS=100000

# Debug output: Show raw XML messages with VISIBLE/FILTERED indicators
SHOW_MESSAGE_DEBUG=false

# =============================================================================
# TAVILY SEARCH API (optional)
# =============================================================================
# Real-time LLM-optimized search via @[Search][query] syntax
# Sign up at https://tavily.com for API key
TAVILY_API_KEY=[your-tavily-api-key]
TAVILY_MAX_RESULTS=5

# =============================================================================
# USAGE
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual API keys
# 3. Run: python main.py
